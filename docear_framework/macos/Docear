#!/bin/bash
# Legacy name — forward to Twigmark launcher beside this file when present,
# otherwise this script is unused (Mac bundle executable is Twigmark).
DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$DIR/Twigmark" ]; then
  exec "$DIR/Twigmark" "$@"
fi
echo "Twigmark launcher missing next to legacy Docear stub" >&2
exit 1
