#!/bin/bash
# Do not use `set -e`: GUI-launched bash + pipelines (java -version | grep) are fragile.
set +e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONTENTS_DIR="$(dirname "$SCRIPT_DIR")"
JAVA_DIR="$CONTENTS_DIR/Resources/Java"
LOG_DIR="${HOME}/Library/Logs/Twigmark"
LOG_FILE="${LOG_DIR}/launch.log"
mkdir -p "$LOG_DIR"
exec >>"$LOG_FILE" 2>&1
echo "========== $(date) =========="
echo "Launching Twigmark from: $0"
echo "uname=$(uname -m) HOME=$HOME PATH=$PATH"

show_error() {
    osascript -e "display alert \"Twigmark 无法启动\" message \"$1\" as critical" 2>/dev/null || true
    echo "ERROR: $1"
    exit 1
}

java_cpu_arch() {
    local info
    info="$(/usr/bin/file -b "$1" 2>/dev/null || true)"
    case "$info" in
        *arm64*|*aarch64*) echo "arm64" ;;
        *x86_64*) echo "x86_64" ;;
        *) echo "unknown" ;;
    esac
}

is_jdk8_home() {
    local home="$1"
    [ -n "$home" ] && [ -x "${home}/bin/java" ] || return 1
    case "$home" in
        *"JavaAppletPlugin"*|*"Internet Plug-Ins"*) return 1 ;;
    esac
    "${home}/bin/java" -version 2>&1 | /usr/bin/grep -qE 'version "1\.8'
}

# Prefer known arm64 JDK 8 homes first (Zulu), then scan, then java_home.
find_java() {
    local home prefer=""
    if [ "$(uname -m)" = "arm64" ]; then
        prefer="arm64"
    fi

    # 1) Explicit high-priority homes (user installs)
    for home in \
        "${HOME}/Library/Java/JavaVirtualMachines/zulu-8.jdk/Contents/Home" \
        "/Library/Java/JavaVirtualMachines/zulu-8.jdk/Contents/Home" \
        "${HOME}/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home" \
        "/Library/Java/JavaVirtualMachines/temurin-8.jdk/Contents/Home"
    do
        if is_jdk8_home "$home"; then
            if [ -z "$prefer" ] || [ "$(java_cpu_arch "${home}/bin/java")" = "$prefer" ]; then
                echo "find_java: prefer hit $home" >&2
                echo "$home"
                return 0
            fi
            echo "find_java: skip wrong arch $home ($(java_cpu_arch "${home}/bin/java"))" >&2
        fi
    done

    # 2) Scan standard JVM directories
    local first=""
    for home in \
        "${HOME}"/Library/Java/JavaVirtualMachines/*/Contents/Home \
        /Library/Java/JavaVirtualMachines/*/Contents/Home
    do
        is_jdk8_home "$home" || continue
        if [ -z "$first" ]; then
            first="$home"
        fi
        if [ -n "$prefer" ] && [ "$(java_cpu_arch "${home}/bin/java")" = "$prefer" ]; then
            echo "find_java: scan hit $home" >&2
            echo "$home"
            return 0
        fi
    done

    if [ -n "$first" ]; then
        echo "find_java: fallback first $first" >&2
        echo "$first"
        return 0
    fi

    # 3) /usr/libexec/java_home
    if [ -x "/usr/libexec/java_home" ]; then
        if [ -n "$prefer" ]; then
            home="$(/usr/libexec/java_home -v 1.8 -a arm64 2>/dev/null || true)"
            if is_jdk8_home "$home"; then
                echo "$home"
                return 0
            fi
        fi
        home="$(/usr/libexec/java_home -v 1.8 2>/dev/null || true)"
        if is_jdk8_home "$home"; then
            echo "$home"
            return 0
        fi
    fi

    return 1
}

JAVA_HOME="$(find_java)" || show_error "未找到 Java 8。Apple Silicon 请安装 Azul Zulu 8 aarch64：\nhttps://www.azul.com/downloads/?version=java-8-lts&os=macos&architecture=arm-64-bit&package=jdk\n或将 JDK 放到 ~/Library/Java/JavaVirtualMachines/"
export JAVA_HOME
JAVACMD="${JAVA_HOME}/bin/java"
[ -x "$JAVACMD" ] || show_error "Java 可执行文件不存在：${JAVA_HOME}/bin/java"

echo "Using JAVA_HOME=$JAVA_HOME"
echo "Using JAVACMD=$JAVACMD"
echo "Java arch: $(java_cpu_arch "$JAVACMD")"
"$JAVACMD" -version 2>&1 || show_error "Java 版本检查失败，请确认已安装 JDK 8。"

cd "$JAVA_DIR" || show_error "找不到应用资源目录：$JAVA_DIR"
FREEDIR="$(pwd)"

DOCK_ICON=""
for candidate in \
    "${CONTENTS_DIR}/Resources/Java/twigmark.png" \
    "${FREEDIR}/twigmark.png" \
    "${CONTENTS_DIR}/Resources/Java/docear.png" \
    "${FREEDIR}/docear.png" \
    "${CONTENTS_DIR}/Resources/twigmark.png" \
    "${CONTENTS_DIR}/Resources/docear.png"
do
    if [ -f "$candidate" ]; then
        DOCK_ICON="$candidate"
        break
    fi
done

JAVA_ARGS=(
    -Xmx1536m
    -Xdock:name=Twigmark
)
if [ -n "$DOCK_ICON" ]; then
    JAVA_ARGS+=("-Xdock:icon=${DOCK_ICON}")
    echo "Using Dock icon: $DOCK_ICON"
fi
JAVA_ARGS+=(
    -Dapple.laf.useScreenMenuBar=true
    -Dcom.apple.macos.useScreenMenuBar=true
    -Dsun.java2d.opengl=false
    -Dorg.freeplane.param1="$1"
    -Dorg.freeplane.param2="$2"
    -Dorg.freeplane.param3="$3"
    -Dorg.freeplane.param4="$4"
    -Dorg.knopflerfish.framework.bundlestorage=memory
    -Dorg.freeplane.globalresourcedir="${FREEDIR}/resources"
    -Dorg.knopflerfish.gosg.jars=reference:file:"${FREEDIR}/core/"
    -jar "${FREEDIR}/framework.jar"
    -xargs "${FREEDIR}/props.xargs"
    -xargs "${FREEDIR}/init.xargs"
)

if [ "$(uname -m)" = "arm64" ] && [ "$(java_cpu_arch "$JAVACMD")" = "x86_64" ]; then
    echo "Running x86_64 JVM under Rosetta: $JAVACMD"
    exec arch -x86_64 "$JAVACMD" "${JAVA_ARGS[@]}"
fi

echo "Running native JVM: $JAVACMD"
exec "$JAVACMD" "${JAVA_ARGS[@]}"
