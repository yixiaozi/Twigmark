<project name="docear_mcp" default="dist" basedir="..">
	<property name="workspace" location=".." />
	<property name="src" value="src" />
	<property name="resources" value="resources" />
	<property name="root" value="."/>
	<property name="osgimanifest" value="${root}/META-INF/MANIFEST.MF" />
	<property file="${workspace}/freeplane_framework/ant/ant.properties" />
	<property file="${workspace}/freeplane/ant/ant.properties" />
	<property file="ant/ant.properties" />
	<property name="external.jars" value="${apache.jars}:${insubstantial.jars}" />
	<property name="build" value="${root}/build" />
	<property name="dist" value="${root}/dist" />
	<property name="dist.osgi.dir" value="${dist}/org.docear.plugin.mcp" />
	<property name="freeplaneplugin.jar" value="${dist}/org.docear.plugin.mcp.jar"/>
	<property name="debug" value="on" />
	<property name="java_source_version" value="1.8" />
	<property name="java_target_version" value="1.8" />
	<property name="build.compiler" value="modern" />
    <property name="classpath" value="${framework.jar}:${freeplane.jars}:${external.jars}:${jhall.jar}:${swingworker.jar}:${core.jar}:${workspace.jar}:${jhyperlink.jar}:${jgoodies.jar}:${ai.jar}:lib/sqlite-jdbc-3.44.1.0.jar:lib/slf4j-api-1.7.36.jar:lib/slf4j-nop-1.7.36.jar"/>

	<target name="build">
		<mkdir dir="${build}" />
		<javac srcdir="${src}" destdir="${build}" classpath="${classpath}" debug="${debug}"
			source="${java_source_version}" target="${java_target_version}" encoding="utf8">
		</javac>
	</target>

	<target name="prepare_cursor_plugin_version">
		<property file="${workspace}/docear_plugin_core/resources/version.properties"/>
		<property file="${workspace}/docear_plugin_core/resources/build.number"/>
		<property name="cursor.plugin.version"
			value="${docear_version}.${docear_version_status_number}_${docear_version_status}_build${build.number}"/>
		<delete dir="${build}/cursor-plugin" quiet="true"/>
		<mkdir dir="${build}/cursor-plugin"/>
		<copy todir="${build}/cursor-plugin">
			<fileset dir="${root}/cursor-plugin">
				<exclude name="README.md"/>
			</fileset>
		</copy>
		<copy file="${build}/cursor-plugin/.cursor-plugin/plugin.json"
			tofile="${build}/cursor-plugin/.cursor-plugin/plugin.json.tmp" overwrite="true"/>
		<replace file="${build}/cursor-plugin/.cursor-plugin/plugin.json.tmp"
			token="@DOCEAR_CURSOR_PLUGIN_VERSION@"
			value="${cursor.plugin.version}"/>
		<move file="${build}/cursor-plugin/.cursor-plugin/plugin.json.tmp"
			tofile="${build}/cursor-plugin/.cursor-plugin/plugin.json"/>
		<echo file="${build}/cursor-plugin/VERSION">${cursor.plugin.version}</echo>
	</target>

	<target name="dist" depends="build,prepare_cursor_plugin_version">
		<jar jarfile="lib/plugin.jar">
			<fileset dir="${build}">
				<exclude name="cursor-plugin/**"/>
			</fileset>
			<fileset dir="${resources}" erroronmissingdir="false"/>
			<fileset dir="${src}">
                <include name="**/*.xml"/>
                <include name="**/*.properties"/>
            </fileset>
		</jar>
		<delete dir="${dist.osgi.dir}" quiet="true"/>
		<mkdir dir="${dist.osgi.dir}" />
		<copy todir="${dist.osgi.dir}">
			<fileset dir="${root}">
				<include name="lib/**"/>
			</fileset>
		</copy>
		<copy todir="${dist.osgi.dir}/cursor-plugin">
			<fileset dir="${build}/cursor-plugin"/>
		</copy>
		<mkdir dir="${dist.osgi.dir}/META-INF" />
		<copy tofile="${dist.osgi.dir}/META-INF/MANIFEST.MF" file="${osgimanifest}"/>
		<delete file="lib/plugin.jar" quiet="true"/>
	</target>

	<target name="osgi_dist_as_jar" depends="dist">
		<jar jarfile="${freeplaneplugin.jar}">
			<fileset dir="${dist.osgi.dir}">
				<include name="**" />
			</fileset>
		</jar>
	</target>

	<target name="clean">
		<delete dir="${build}" quiet="true"/>
		<delete dir="${dist}" quiet="true"/>
		<delete>
			<fileset defaultexcludes="no" dir="${src}" includes="**/*~"/>
		</delete>
	</target>
</project>
